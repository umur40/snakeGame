 body {
      background-color: #111;
      color: #eee;
      font-family: Arial, sans-serif;
      text-align: center;
      margin: 0;
      padding: 0;
    }

    h1 {
      margin-top: 20px;
      font-size: 32px;
      color: #00ff00;
    }

    canvas {
      background-color: #000;
      border: 4px solid #00ff00;
      display: block;
      margin: 20px auto;
    }

    #score {
      font-size: 20px;
      color: #fff;
    }

    button {
      padding: 10px 20px;
      font-size: 16px;
      margin-top: 10px;
      cursor: pointer;
      background-color: #00aa00;
      color: white;
      border: none;
      border-radius: 5px;
    }

    button:hover {
      background-color: #009900;
    }
